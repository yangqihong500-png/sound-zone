# Copy to .env.production on the server. Never commit the real file.
COMPOSE_PROJECT_NAME=soundzone
HTTP_PORT=80
HTTPS_PORT=443

MYSQL_DATABASE=soundzone
MYSQL_USER=soundzone
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

# Use the final HTTPS origin after the domain and certificate are ready.
# For initial IP-only verification, use http://YOUR_SERVER_IP.
PUBLIC_ORIGIN=https://soundzones.cn

SOUNDZONE_ADMIN_KEY=replace-with-a-long-random-admin-key
SOUNDZONE_GUEST_ENABLED=true
# Caddy 自动申请和续期 HTTPS 证书，因此正式域名可安全开放密码登录。
SOUNDZONE_PASSWORD_AUTH_ENABLED=true
SOUNDZONE_DEMO_DATA_ENABLED=true

SOUNDZONE_AUDIUS_ENABLED=true
SOUNDZONE_AUDIUS_API_KEY=
SOUNDZONE_AUDIUS_BEARER_TOKEN=
